{
  "darkmode": true,
  "themeLocation": "theme.json",
  "pages": [
    "pages/home/index",
    "pages/login/index",
    "pages/mine/index"
  ],
  "subpackages": [
    {
      "root": "pages/notifications",
      "name": "notifications"
    },
    {
      "root": "pages/students",
      "name": "students"
    },
    {
      "root": "pages/leaves",
      "name": "leaves"
    },
    {
      "root": "pages/reviewers",
      "name": "reviewers"
    },
    {
      "root": "pages/teachers",
      "name": "teachers"
    },
    {
      "root": "pages/courses",
      "name": "courses"
    }
  ],
  "window": {
    "navigationBarBackgroundColor": "@bgColor",
    "navigationBarTextStyle": "@style",
    "navigationBarTitleText": "请假管理系统",
    "backgroundColor": "@bgColor",
    "backgroundColorTop": "@bgColor",
    "backgroundColorBottom": "@bgColor"
  },
  "tabBar": {
    "color": "@color",
    "selectedColor": "@color",
    "backgroundColor": "@bgColor",
    "borderStyle": "@style",
    "list": [
      {
        "text": "主页",
        "pagePath": "pages/home/index",
        "iconPath": "@homeIcon",
        "selectedIconPath": "@homeSelectedIcon"
      },
      {
        "text": "我",
        "pagePath": "pages/mine/index",
        "iconPath": "@mineIcon",
        "selectedIconPath": "@mineSelectedIcon"
      }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}